{% load form_tags %}
<div>
    <label for="{{ field.id_for_label }}" class="label">
        <span class="label-text">{{ field.label }}</span>
    </label>
    {% if field.name == "password1" or field.name == "password2" %}
        {% style_input field "input input-bordered w-full" "password" %}
    {% else %}
        {% style_input field "input input-bordered w-full" "text" %}
    {% endif %}
    {% if field.errors %}
        {% for error in field.errors %}<p class="text-sm text-red-500">{{ error }}</p>{% endfor %}
    {% endif %}
</div>
