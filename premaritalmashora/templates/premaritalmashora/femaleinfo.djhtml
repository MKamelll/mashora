{% extends "common/base.djhtml" %}
{% block content %}
    <div class="max-w-2xl mx-auto p-4">
        <form hx-post="/submitmaleinfo"
              class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-base-200 p-6 rounded-lg shadow">
            {% include "common/components/name.djhtml" with label='اسم الشريكة' id='female-name' %}
            {% include "common/components/number.djhtml" with label='السن' placeholder='بالسنوات' id='female-age' %}
            <div>
                <label class="label">
                    <span class="label-text">مستوى التعليم</span>
                </label>
                <select class="select select-bordered w-full">
                    <option value="none">أمي</option>
                    <option value="can-read">يجيد القراءة</option>
                    <option value="moderate">مؤهل متوسط</option>
                    <option value="above-moderate">فوق المتوسط</option>
                    <option value="excellant">مؤهل عالي</option>
                </select>
            </div>
            <div>
                <label class="label">
                    <span class="label-text">الوظيفة</span>
                </label>
                <select class="select select-bordered w-full">
                    <option value="work">يعمل</option>
                    <option value="doesnot-work">لا يعمل</option>
                </select>
            </div>
            {% include "common/components/number.djhtml" with label='الرقم القومي' placeholder='تأكد من كتابة 14 رقم' id='female-national-id' %}
            {% include "common/components/number.djhtml" with label='رقم الهاتف' placeholder='تأكد من كتابة 11 رقم' id='female-phone-number' %}
            <div class="md:col-span-2 text-right flex justify-end">
                <button type="submit" class="btn btn-primary">متابعة</button>
            </div>
        </form>
    </div>
{% endblock content %}
