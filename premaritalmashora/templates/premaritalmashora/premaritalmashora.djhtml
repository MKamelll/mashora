{% extends "common/base.djhtml" %}
{% block content %}
    <span id="dashboard_title" hx-swap-oob="true">تسجيل حالة ماقبل الزواج</span>
    <div x-data="{tab: ''}" role="tablist" class="tabs tabs-bordered">
        <a role="tab"
           :class="tab === 'maleinfo'? 'tab tab-active' : 'tab'"
           @click="tab = 'maleinfo'"
           hx-get="/premaritalmashora/maleinfo"
           hx-target="#info"
           hx-swap="innerHTML">بيانات الشريك</a>
        <a role="tab"
           :class="tab === 'femaleinfo'? 'tab tab-active' : 'tab'"
           @click="tab = 'femaleinfo'"
           hx-get="/premaritalmashora/femaleinfo"
           hx-target="#info"
           hx-swap="innerHTML">بيانات الشريكة</a>
        <a role="tab"
           :class="tab === 'meetinginfo'? 'tab tab-active' : 'tab'"
           @click="tab = 'meetinginfo'"
           hx-get="/premaritalmashora/meetinginfo"
           hx-target="#info"
           hx-swap="innerHTML">بيانات اللقاء</a>
        <a role="tab"
           :class="tab === 'meetingtopics'? 'tab tab-active' : 'tab'"
           @click="tab = 'meetingtopics'"
           hx-get="/premaritalmashora/meetingtopics"
           hx-target="#info"
           hx-swap="innerHTML">موضوعات اللقاء</a>
    </div>
    <div id="info" class="m-4"></div>
{% endblock content %}
