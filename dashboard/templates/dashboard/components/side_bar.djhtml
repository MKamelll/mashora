<ul x-data="{ selected: null }"
    class="menu bg-base-100 rounded-lg w-full gap-4">
    <li>
        <a hx-get="/search"
           hx-target="#dashboard_body"
           hx-swap="innerHTML"
           :class="selected === 'search' ? 'flex flex-row justify-start gap-2 w-full bg-primary' : 'flex flex-row justify-start gap-2 w-full'"
           @click="selected = 'search'">
            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="1.5"
                 stroke="currentColor"
                 class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            البحث
        </a>
    </li>
    <li>
        <details @toggle="if (!$el.open) selected = null">
            <summary>
                <svg xmlns="http://www.w3.org/2000/svg"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke-width="1.5"
                     stroke="currentColor"
                     class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
                تسجيل حالة
            </summary
        </summary>
        <ul>
            <li>
                <a hx-get="/childmashora"
                   hx-target="#dashboard_body"
                   hx-swap="innerHTML"
                   :class="{'bg-primary': selected === 'children'}"
                   @click="selected = 'children'">أطفال</a>
            </li>
            <li>
                <a :class="{'bg-primary': selected === 'pregnant'}"
                   @click="selected = 'pregnant'">حوامل</a></a>
            </li>
            <li>
                <a :class="{'bg-primary': selected === 'premarital'}"
                   @click="selected = 'premarital'">ما قبل الزواج</a>
            </li>
        </ul>
    </details>
</ul>
