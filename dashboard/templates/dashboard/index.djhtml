{% extends "common/base.djhtml" %}
{% block title %}
    الصفحة الرئيسية
{% endblock title %}
{% block content %}
    {% include "dashboard/components/navbar.djhtml" with drawer="my-drawer-5" title="الصفحة الرئيسية" %}
    <div class="drawer lg:drawer-open">
        <input id="my-drawer-5" type="checkbox" class="drawer-toggle" />
        <div id="dashboard-body"
             class="drawer-content flex flex-col items-center justify-start p-4"></div>
        <div class="drawer-side">
            <label for="my-drawer-5" aria-label="close sidebar" class="drawer-overlay"></label>
            <ul class="menu bg-base-200 min-h-full w-48 p-4">
                {% include "dashboard/components/side_bar.djhtml" %}
            </ul>
        </div>
    </div>
{% endblock content %}
