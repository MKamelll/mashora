{% extends "common/base.djhtml" %}
{% block title %}
    انشاء حساب
{% endblock title %}
{% block content %}
    <div id="registertarget" class="max-w-2xl mx-auto p-4">
        <form id="registerform"
              hx-post="/register/"
              hx-push-url="true"
              hx-target="#registertarget"
              hx-swap="innerHTML"
              class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-base-200 p-6 rounded-lg shadow"
              novalidate>
            {% csrf_token %}
            <h1>fuck off</h1>
            {% for error in form.non_field_errors %}<div class="text-red-500">{{ error }}</div>{% endfor %}
            <div class="md:col-span-2 text-right flex justify-end">
                <button type="submit" class="btn btn-primary">انشاء حساب</button>
            </div>
        </form>
    </div>
{% endblock content %}
