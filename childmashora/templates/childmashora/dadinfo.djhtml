{% extends "common/base.d.djhtml" %}
{% block title %}
    بيانات الأب
{% endblock title %}
{% block content %}
    <div class="max-w-2xl mx-auto p-4">
        <form class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-base-200 p-6 rounded-lg shadow">
            {% include "common/components/name.djhtml" with label='الاسم' id='dad-name' %}
            {% include "common/components/number.djhtml" with label='الرقم القومي' placeholder='تأكد من كتابة 14 رقم' id='dad-national-id' %}
            {% include "common/components/number.djhtml" with label='رقم الهاتف' placeholder='تأكد من كتابة 11 رقم' id='dad-phone-number' %}
            {% include "common/components/education.djhtml" with label='مستوي تعليم الأب' id='dad-education' %}
            {% include "common/components/employment.djhtml" with label='وظيفة الأب' id='dad-employment' %}
            <div class="md:col-span-2 text-right flex justify-end">
                <button class="btn btn-primary">متابعة</button>
            </div>
        </form>
    </div>
{% endblock content %}
