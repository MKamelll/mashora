{% extends "common/base.djhtml" %}
{% block content %}
    <div class="max-w-2xl mx-auto p-4">
        <form class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-base-200 p-6 rounded-lg shadow">
            <c-common.input label="الاسم"
                            id="child-name"
                            placeholder="الاسم ثلاثي علي الأقل"
                            type="text" />
            <c-common.input label='تاريخ الميلاد' id='child-birth-date' type="date" />
            <c-common.input label='العمر الحالي للطفل'
                            placeholder='بالشهور'
                            id='child-current-age'
                            type="number" />
            <c-common.input label='العمر الرحمي للطفل'
                            placeholder='بالاسبوع'
                            id='child-age-since-conception'
                            type="number" />
            <div class="flex flex-col gap-2" x-data="{followup_place_selected: ''}">
                <c-common.select label="مكان المتابعة"
                                 id="follow-up-place"
                                 x-model="followup_place_selected"
                                 :options="{'unit': 'وحدة', 'hospital': 'مستشفي', 'other': 'اخري'}" />
                <c-common.input x-show="followup_place_selected === 'unit'"
                                id="follow-up-place-unit"
                                type="text"
                                placeholder="ادخل اسم الوحدة" />
                <c-common.input x-show="followup_place_selected === 'hospital'"
                                id="follow-up-place-hospital"
                                type="text"
                                placeholder="ادخل اسم المستشفي" />
                <c-common.input x-show="followup_place_selected === 'other'"
                                id="follow-up-place-other"
                                type="text"
                                placeholder="ادخل اسم المكان" />
            </div>
            <div class="flex flex-col gap-2" x-data="{referal_source: ''}">
                <c-common.select label="مصدر الاحالة"
                                 id="referal-source"
                                 :options="{'hospital': 'مستشفي', 'clinic': 'عيادة خاصة', 'vaccine-clinic': 'عيادة التطعيمات', 'advice': 'نصيحة'}"
                                 x-model="referal_source" />
                <c-common.input x-show="referal_source === 'hospital'"
                                id="referal-source-hospital"
                                type="text"
                                placeholder="ادخل اسم المستشفي" />
                <c-common.input x-show="referal_source === 'clinic'"
                                id="referal-source-clinic"
                                type="text"
                                placeholder="ادخل اسم العيادة الخاصة" />
            </div>
            <c-common.select label="نوع الولادة"
                             id="pregnancy-procedure"
                             :options="{'c-section': 'قيصري', 'non-c-section': 'طبيعي'}" />
            <c-common.select label="مكان الولادة"
                             id="conception-place"
                             :options="{'home': 'المنزل', 'hospital': 'المستشفي'}" />
            <c-common.input label="وزن الطفل عند الولادة"
                            type="number"
                            placeholder="بالجرام"
                            id="child-birth-weight" />
            <c-common.input label="طول الطفل عند الولادة"
                            type="number"
                            placeholder="بالسنتيمتر"
                            id="child-birth-height" />
            <c-common.input label="مقاس راس الطفل عند الولادة"
                            type="number"
                            placeholder="بالسنتيمتر"
                            id="child-birth-head-size" />
            <div x-data="{baby_hospitalization: ''}">
                <c-common.select label="دخول الحضانة"
                                 id="birth_hospitalized"
                                 :options="{'yes': 'تم', 'no': 'لم يتم'}"
                                 x-model="baby_hospitalization" />
                <c-common.select label="سبب دخول الحضانة"
                                 id="reason-for-birth-hospitalization"
                                 :options="{'below-average-weight': 'انخفاض وزن الطفل', 'need-for-medication': 'احتياج الطفل لأدوية محددة بهذا الوقت', 'difficulty-breathing': 'صعوبة شديدة في التنفس لعدم اكتمال نمو الرئتين', 'fever': 'ارتفاع درجة حرارة جسم الرضيع', 'abnormal-vital-signs': 'تعطل العمليات الحيوية بجسم الطفل', 'hypoglycemia': 'انخفاض معدل الجلوكوز في دم الطفل', 'abnormal-git-function': 'معاناة الرضيع مشكلات في الجهاز الهضمي', 'blood-infection': 'اصابة الطفل بعدوي في الدم', 'jaundice': 'اصابة الطفل بالصفراء', 'problems-during-pregnancy': 'حدوث مشكلات خلال الولادة الولادة المتعسرة أو الحمل الحرج', 'birth-defect': ' وجود عيب خلقي يمنع الطفل عن التنفس أو الرضاعة بشكل طبيعي'}"
                                 x-show="baby_hospitalization === 'yes'" />
                <div x-show="baby_hospitalization === 'yes'" x-transition>
                    {% include "common/components/number.djhtml" with label='مدة البقاء في الحضانة' placeholder='بالأيام'
                    id='birth-hospitalization-duration' %}
                </div>
            </div>
            {% include "common/components/topicdisscused.djhtml" with label='ملامسة الجلد في الساعة الذهبية الأولي'
            id='first-hour-skin-to-skin-contact' %}
            {% include "common/components/topicdisscused.djhtml" with label='الرضاعة الطبيعية في الساعة الذهبية الأولي'
            id='first-hour-breast-feeding' %}
            <div class="md:col-span-2 text-right flex justify-end">
                <button class="btn btn-primary">متابعة</button>
            </div>
        </form>
    </div>
{% endblock content %}
