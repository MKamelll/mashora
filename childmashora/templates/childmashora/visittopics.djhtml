{% extends "common/base.djhtml" %}
{% block title %}
    مواضيع الزيارة
{% endblock title %}
{% block content %}
    <div class="max-w-2xl mx-auto p-4">
        <form class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-base-200 p-6 rounded-lg shadow">
            {% include "common/components/topicdisscused.djhtml" with label='فوائد الرضاعة الطبيعية والأوضاع وعلامات الجوع والشبع' id='breast-feeding-benefits' %}
            {% include "common/components/topicdisscused.djhtml" with label='كفاية اللبن وكمية البراز' id='normal-stool-freq' %}
            {% include "common/components/topicdisscused.djhtml" with label='اعطاء الجرعة اليومية من فيتامين د' id='vitamin-d-supplement' %}
            {% include "common/components/topicdisscused.djhtml" with label='كيفية رعاية السرة والاهتمام بنظافة الطفل' id='navel-care-and-hygiene' %}
            {% include "common/components/topicdisscused.djhtml" with label='البطاقة الصحية وأهمية المتابعة الدورية ومنحنيات النمو' id='health-care-id-and-follow-up' %}
            {% include "common/components/topicdisscused.djhtml" with label='اهمية الالتزام بتطعيمات الطفل' id='vaccination' %}
            {% include "common/components/topicdisscused.djhtml" with label='التغذية الصحية للأم المرضعة' id='nutrition-for-breast-feeding-mother' %}
            {% include "common/components/topicdisscused.djhtml" with label='كيفية التعرف علي علامات الخطورة' id='recognizing-abnormal-behaviour' %}
            <div class="border border-base-300 p-4 rounded-lg bg-base-100 shadow-sm mt-6">
                <h3 class="text-lg font-semibold mb-4 text-base-content">الرسائل الصحية الخاصة بالنمو و التطور</h3>
                <div>
                    <label class="label">
                        <span class="label-text mt-2">النمو والتطور الحركي</span>
                    </label>
                    <select class="select select-bordered w-full">
                        <option selected value="">اختر</option>
                        <option value="above-average">متأخر</option>
                        <option value="normal">طبيعي</option>
                        <option value="below-average">متقدم</option>
                    </select>
                </div>
                <div>
                    <label class="label">
                        <span class="label-text mt-2">التطور الادراكي والمعرفي</span>
                    </label>
                    <select class="select select-bordered w-full">
                        <option selected value="">اختر</option>
                        <option value="above-average">متأخر</option>
                        <option value="normal">طبيعي</option>
                        <option value="below-average">متقدم</option>
                    </select>
                </div>
                <div>
                    <label class="label">
                        <span class="label-text mt-2">التطور اللغوي</span>
                    </label>
                    <select class="select select-bordered w-full">
                        <option selected value="">اختر</option>
                        <option value="above-average">متأخر</option>
                        <option value="normal">طبيعي</option>
                        <option value="below-average">متقدم</option>
                    </select>
                </div>
            </div>
            <div>
                {% include "common/components/topicdisscused.djhtml" with label='رسائل التربية الايجابية' id='positive-education' %}
                {% include "common/components/topicdisscused.djhtml" with label='الانشطة التحفيزية' id='encouraging-activities' %}
                {% include "common/components/topicdisscused.djhtml" with label='التوعية عن التغذية التكميلية وسلامة الغذاء والتغذية السليمة' id='nutrition-info' %}
                {% include "common/components/topicdisscused.djhtml" with label='إعطاء الجرعة اليومية من الحديد' id='iron-supplement' %}
                {% include "common/components/topicdisscused.djhtml" with label='أهمية إستخدام وسيلة تنظيم أسرة وأهمية المباعدة' id='contraceptives' %}
            </div>
            <div>
                <div>
                    <label class="label">
                        <span class="label-text">موقف إستخدام وسيلة تنظيم أسرة</span>
                    </label>
                    <select id="is-using-contraceptive" class="select select-bordered w-full">
                        <option value="yes">يوجد</option>
                        <option value="no">لا يوجد</option>
                    </select>
                </div>
                <div>
                    <label class="label">
                        <span class="label-text">الحمل الجديد</span>
                    </label>
                    <select id="new-pregnancy-plan" class="select select-bordered w-full">
                        <option value="planned">مرغوب</option>
                        <option value="not-planned">غير مرغوب</option>
                    </select>
                </div>
                {% include "common/components/topicdisscused.djhtml" with label='الخدمات الغير ملباه' id='other-unavailable-services' %}
            </div>
            <div>
                <div class="max-w-md mx-auto mt-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">ملاحاظات/توصيات</label>
                    <textarea class="textarea textarea-bordered w-full h-20"></textarea>
                </div>
                <div class="max-w-md mx-auto mt-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">تخطيط الزيارة القادمة</label>
                    <textarea class="textarea textarea-bordered w-full h-20"></textarea>
                </div>
            </div>
        </form>
    </div>
{% endblock content %}
